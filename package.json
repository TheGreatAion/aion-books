{
  "name": "aionbooks",
  "productName": "AionBooks",
  "desktopName": "aionbooks.desktop",
  "version": "1.6.7",
  "description": "A quiet e-book reader and library.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:app": "playwright test",
    "fixtures": "node tests/fixtures/make-fixtures.js",
    "pack": "electron-builder --win dir",
    "pack:linux": "electron-builder --linux dir",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "version": "node scripts/site-version.js",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "keywords": [
    "ebook",
    "epub",
    "ebook",
    "reader",
    "electron"
  ],
  "author": "TheGreatAion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheGreatAion/aion-books.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.aionbooks.reader",
    "productName": "AionBooks",
    "publish": [
      {
        "provider": "github",
        "owner": "TheGreatAion",
        "repo": "aion-books",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "build/icon.png",
      "node_modules/**",
      "!node_modules/@fontsource/*/*.css",
      "!node_modules/@fontsource/*/*.scss",
      "!node_modules/@fontsource/*/files/*.woff",
      "!node_modules/@fontsource/*/files/*-{cyrillic,cyrillic-ext,greek,greek-ext,vietnamese,latin-ext,math,symbols,hebrew}-*"
    ],
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "EPUB Book",
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      },
      {
        "ext": [
          "mobi",
          "azw3",
          "azw"
        ],
        "name": "Kindle Book",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer"
      },
      {
        "ext": "fb2",
        "name": "FictionBook",
        "mimeType": "application/x-fictionbook+xml",
        "role": "Viewer"
      },
      {
        "ext": "cbz",
        "name": "Comic Book",
        "mimeType": "application/vnd.comicbook+zip",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "aionbooks",
      "syncDesktopName": true,
      "synopsis": "A quiet e-book reader and library",
      "maintainer": "TheGreatAion",
      "artifactName": "AionBooks-${version}.${ext}"
    },
    "appImage": {
      "mimeTypes": [
        "application/vnd.amazon.mobi8-ebook",
        "application/vnd.amazon.ebook",
        "application/x-cbz"
      ]
    },
    "deb": {
      "mimeTypes": [
        "application/vnd.amazon.mobi8-ebook",
        "application/vnd.amazon.ebook",
        "application/x-cbz"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AionBooks",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AionBooks-Setup-${version}.${ext}"
    }
  }
}
